# ============================================================
#  Скопируйте этот файл в .env и заполните свои значения:
#  cp .env.example .env   (Linux/macOS) / copy .env.example .env (Windows)
# ============================================================

# ==== Telegram ====
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# По умолчанию используется официальный API. Если поднимете локальный
# Telegram Bot API Server — укажите его базовый URL здесь.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# Для РФ: публичное зеркало Telegram Bot API (доступно без прокси):
# TELEGRAM_API_BASE_URL=https://telegram.ebalo.lol
# SOCKS5-прокси для Telegram (опционально)
# TELEGRAM_PROXY_SOCKS5=socks5://user:pass@host:port

# ==== LLM — основной провайдер (OpenAI-совместимый API) ====
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ==== LLM — резерв 1 (необязательно, автофолбэк при сбоях) ====
# LLM_RESERVE_URL=https://openrouter.ai/api/v1
# LLM_RESERVE_KEY=sk-or-...
# LLM_RESERVE_MODEL=deepseek/deepseek-chat
# LLM_RESERVE_ENABLED=true

# ==== LLM — резерв 2 (необязательно, последний рубеж) ====
# LLM_FALLBACK_URL=https://api.deepseek.com/v1
# LLM_FALLBACK_KEY=sk-...
# LLM_FALLBACK_MODEL=deepseek-chat
# LLM_FALLBACK_ENABLED=true

# ==== Ключи провайдеров для команды /model (каталог в providers.py) ====
# Заполните только те, которыми будете пользоваться в инлайн-меню бота.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=

# ==== Пятёрочка ====
# Путь к JSON с cookies браузера (см. раздел «Cookies» в README).
# Храните ВНЕ репозитория — файл содержит живую веб-сессию!
# PYATEROCHKA_COOKIES_FILE=C:\secrets\pyaterochka\cookies.json
# SOCKS5-прокси для запросов к 5ka.ru (опционально)
# PYATEROCHKA_PROXY=socks5://user:pass@host:port

# ==== HTTP MCP-сервер ====
MCP_HOST=127.0.0.1
MCP_PORT=8765
